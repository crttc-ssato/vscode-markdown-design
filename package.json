{
  "name": "vscode-markdown-design",
  "displayName": "Markdown Design",
  "description": "テーマに馴染むMarkdownデザインと、チェックリストを編集できるプレビュー。",
  "version": "0.3.0",
  "publisher": "crttc-ssato",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crttc-ssato/vscode-markdown-design.git"
  },
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce package",
    "build": "node scripts/build.cjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.1.0",
    "sanitize-html": "^2.17.0"
  },
  "contributes": {
    "markdown.previewStyles": [
      "./styles/preview.css"
    ],
    "commands": [
      {
        "command": "markdownDesign.openPreview",
        "title": "Markdown Design: 専用画面を開く",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownDesign.refreshExplorer",
        "title": "Markdown Design: 一覧を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownDesign.openSource",
        "title": "Markdown Design: ソースを開く",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [],
      "view/title": [
        {
          "command": "markdownDesign.refreshExplorer",
          "when": "view == markdownDesign.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownDesign.openSource",
          "when": "view == markdownDesign.explorer && viewItem == markdownFile",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownDesign.openSource",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "markdownDesign.preview",
        "displayName": "Markdown Design",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownDesign",
          "title": "Markdown Design",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "markdownDesign": [
        {
          "id": "markdownDesign.explorer",
          "name": "Markdownエクスプローラー"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "markdownDesign.explorer",
        "contents": "Markdownを読むフォルダーを開いてください。\n[フォルダーを開く](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "markdownDesign.explorer",
        "contents": "Markdownファイルが見つかりません。\n.md または .markdown ファイルを追加してください。\n[一覧を更新](command:markdownDesign.refreshExplorer)",
        "when": "workbenchState != empty"
      }
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.3"
  }
}
